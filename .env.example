# Host ports. Change them if something on your machine already uses 5432, 8000 or 8501.
CASHFLOW_DB_PORT=5432
CASHFLOW_API_PORT=8000
CASHFLOW_DASHBOARD_PORT=8501

# Account mapping suggestions: "rules" (offline, default) or "openai".
CASHFLOW_SUGGESTER=rules
OPENAI_API_KEY=
CASHFLOW_OPENAI_MODEL=gpt-5-mini
